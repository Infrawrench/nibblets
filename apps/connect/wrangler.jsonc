// Nibblets Connect: the central service. Secrets (CLERK_SECRET_KEY,
// CLERK_PUBLISHABLE_KEY, JWT_PRIVATE_KEY, and optionally CF_API_TOKEN) are set
// with `wrangler secret put`; see README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nibblets-connect",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  // workers.dev stays on so servers linked before the custom domain keep
  // reaching it; their next heartbeat moves them to PUBLIC_URL.
  "workers_dev": true,
  "routes": [{ "pattern": "app.nibblets.dev", "custom_domain": true }],
  // Sweeps away links that were approved but never collected.
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nibblets-connect",
      "database_id": "cd9f7ecb-0ff7-4fbd-88e3-407f59076c7b",
      "migrations_dir": "migrations",
    },
  ],
  // The central UI: the web app built in central mode. The API and JWKS run
  // the Worker first; everything else is the single-page app.
  "assets": {
    "directory": "../web/dist-central",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/.well-known/*"],
  },
  "vars": {
    // The address servers and tokens use for this service. Empty: whatever
    // address the request came in on. Set it when adding a custom domain.
    "PUBLIC_URL": "https://app.nibblets.dev",
    // Where managed tunnels go. Empty: servers use quick tunnels instead.
    "CF_ACCOUNT_ID": "906034adfe1c457d2388331e220efcc7",
    "CF_ZONE_ID": "1a13924531207540ca5002c03f5a965a",
    "CF_ZONE_NAME": "nibblets.dev",
    // Who push services can contact about the notifications this sends.
    "VAPID_SUBJECT": "mailto:astrid@infrawrench.com",
  },
}
