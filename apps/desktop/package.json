{
  "name": "@nibblet/desktop",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron .",
    "package": "node build.mjs && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir",
    "typecheck": "tsc -p .",
    "dist:mac": "node build.mjs && electron-builder --mac --publish never",
    "dist:linux": "node build.mjs && electron-builder --linux --publish never",
    "dist:win": "node build.mjs && electron-builder --win --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "@nibblet/host-mcp": "workspace:*",
    "@nibblet/protocol": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "node-pty": "1.1.0",
    "zod": "^4.6.7"
  },
  "main": "out/main.cjs",
  "description": "Runs your nibblets on this machine",
  "author": "Infrawrench",
  "homepage": "https://nibblets.dev"
}
