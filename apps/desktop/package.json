{
  "name": "@nibblet/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron .",
    "pack": "node build.mjs && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir",
    "dist": "node build.mjs && electron-builder --mac --publish never",
    "typecheck": "tsc -p ."
  },
  "dependencies": {},
  "devDependencies": {
    "@nibblet/host-mcp": "workspace:*",
    "@nibblet/protocol": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "node-pty": "1.1.0",
    "zod": "^4.6.7"
  },
  "main": "out/main.cjs",
  "description": "Runs your nibblets on this machine"
}
