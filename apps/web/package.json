{
  "name": "@nibblet/web",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p .",
    "icons": "for n in 192 512; do rsvg-convert -w $n -h $n public/icons/icon.svg -o public/icons/icon-$n.png; done && rsvg-convert -w 180 -h 180 public/icons/icon.svg -o public/icons/apple-touch-icon.png",
    "build:central": "vite build --mode central --outDir dist-central --emptyOutDir",
    "dev:central": "vite --mode central"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/react": "^6.17.8",
    "@nibblet/protocol": "workspace:*",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.45",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
